# Copie para .env no dev local (.env é gitignored e NÃO existe no deploy).
# Em produção estas variáveis vêm do GitHub Secret APP_SECRETS.

# Postgres. No cluster o host é o nome do serviço do compose ("db").
DATABASE_URL=postgres://app:app@localhost:5432/app

# Porta do servidor Express (a mesma declarada no docker-compose.yaml).
PORT=3000

# Só no dev local: o gateway da Vibe não existe aqui, então não há X-Auth-Email.
# Nunca definir isto em produção.
DEV_FAKE_EMAIL=dev@tractian.com

# ---------------------------------------------------------------- sync de tempos
#
# Planilha "Análises Best Laps", que alimenta o tempo-padrão por dispositivo.
# SEM estas variáveis o app sobe normalmente, só com o sync desarmado — é o estado
# esperado no dev local. Defina só se quiser exercitar o agendador aqui.
#
# TEMPOS_SHEET_ID=1sTJrXZ3TBi444ZFJCg9PR8L74RnYCQm4jlRWgnrdeCU
# TEMPOS_SHEET_ABA=Perfomancedev
# TEMPOS_SYNC_HORAS=24
#
# A credencial NUNCA vai para o repo. No dev aponte para o arquivo em ~/.secrets;
# nas Raspberry o deploy monta o segredo em /run/secrets/google-sa.json.
# GOOGLE_APPLICATION_CREDENTIALS=/c/Users/<voce>/.secrets/<service-account>.json
