# Copie para .env no dev local (.env é gitignored e NÃO existe no deploy).
# Em produção estas variáveis vêm do GitHub Secret APP_SECRETS.

# Postgres. No cluster o host é o nome do serviço do compose ("db").
DATABASE_URL=postgres://app:app@localhost:5432/app

# Porta do servidor Express (a mesma declarada no docker-compose.yaml).
PORT=3000

# Só no dev local: o gateway da Vibe não existe aqui, então não há X-Auth-Email.
# Nunca definir isto em produção.
DEV_FAKE_EMAIL=dev@tractian.com
